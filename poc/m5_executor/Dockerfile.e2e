# verify-bridge-e2e image: same toolchain/SDK layers as Dockerfile, plus the
# simulated LFS writer domain. Requires app/generated/ from the host e2e_bundle
# step and two BuildKit secrets (pcb_seed, lfs_seed); no seed enters a layer.
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG MICROKIT_VERSION=2.3.0
ARG MICROKIT_SDK_SHA256=e12e507f72c87cbf5c514df9e9b0c66103b42298852f44c045d5729ea3de4f89
ARG RUST_TOOLCHAIN=nightly-2025-10-20

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    libclang-dev \
    ninja-build \
    python3 \
    qemu-system-arm \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"
ENV MICROKIT_SDK=/microkit
ENV RUSTUP_TOOLCHAIN=${RUST_TOOLCHAIN}

RUN set -eux; \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
            --component rust-src --component llvm-tools-preview; \
    rustup target add --toolchain "${RUST_TOOLCHAIN}" aarch64-unknown-none; \
    rustc --version

RUN set -eux; \
    curl --proto '=https' --tlsv1.2 -fsSL \
        "https://github.com/seL4/microkit/releases/download/${MICROKIT_VERSION}/microkit-sdk-${MICROKIT_VERSION}-linux-x86-64.tar.gz" \
        -o /tmp/microkit-sdk.tar.gz; \
    echo "${MICROKIT_SDK_SHA256}  /tmp/microkit-sdk.tar.gz" | sha256sum -c -; \
    mkdir -p "${MICROKIT_SDK}"; \
    tar -xzf /tmp/microkit-sdk.tar.gz -C "${MICROKIT_SDK}" --strip-components=1; \
    rm /tmp/microkit-sdk.tar.gz; \
    test -x "${MICROKIT_SDK}/bin/microkit"; \
    test -x "$(command -v qemu-system-aarch64)"

WORKDIR /work

COPY Makefile executor.system executor-e2e.system check-wx.py ./
COPY app/ ./app/

RUN chmod +x app/rustc-wrapper.sh
RUN test -s app/generated/e2e_frame.bin && test -s app/generated/e2e_meta.bin \
    && test -s app/generated/e2e_frame_short.bin && test -s app/generated/e2e_clock.bin
RUN --mount=type=secret,id=pcb_seed,required=true --mount=type=secret,id=lfs_seed,required=true \
    VELA_PCB_SEED=/run/secrets/pcb_seed VELA_LFS_SEED=/run/secrets/lfs_seed make build E2E=1

CMD ["make", "run", "E2E=1"]
