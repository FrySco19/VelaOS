<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Vela</vendor>
  <action id="org.vela.settings.updates">
    <description>Change automatic update settings</description>
    <description xml:lang="it">Modifica le impostazioni degli aggiornamenti automatici</description>
    <message>Authentication is required to change automatic update settings.</message>
    <message xml:lang="it">Per modificare gli aggiornamenti automatici è necessaria la password.</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/vela/settings/vela-updates-helper</annotate>
  </action>
</policyconfig>
